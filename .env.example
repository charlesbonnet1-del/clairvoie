# Chaîne de connexion via le pooler PgBouncer (Supabase : "Transaction pooler", port 6543).
# Utilisée à l'exécution par l'application.
DATABASE_URL="postgresql://postgres.xxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe, non poolée (Supabase : "Direct connection", port 5432).
# Requise uniquement par Prisma pour exécuter les migrations.
DIRECT_URL="postgresql://postgres.xxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

SESSION_SECRET="change-me-in-production"
