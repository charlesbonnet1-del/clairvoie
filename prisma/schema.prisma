// Schéma Prisma — Clairvoie MVP
// Postgres (Supabase). DATABASE_URL = connexion via le pooler PgBouncer
// (utilisée à l'exécution) ; DIRECT_URL = connexion directe, requise par
// Prisma pour exécuter les migrations (le pooler ne les supporte pas).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identité — jamais mêlée au contenu des signalements (Ticket) au niveau du
// schéma. Le seul pont entre les deux mondes est le pseudoId, opaque.
// ---------------------------------------------------------------------------
model Identity {
  id            String   @id @default(cuid())
  pseudoId      String   @unique
  // "PARENT" | "ETABLISSEMENT" | "ASSOCIATION_TIERCE" | "RECTORAT" | "ADMIN"
  // Champ String plutôt qu'un enum Postgres natif : la liste exhaustive des
  // rôles autorisés vit dans config.ts (export ROLES), pas dans le schéma.
  // C'est cette liste, pas ce champ, que le test du principe 2 (aucun rôle
  // judiciaire) vérifie.
  role          String
  displayName   String // pour la démo uniquement, jamais exposé publiquement
  email         String   @unique
  passwordHash  String
  // Rattachement pour les comptes ETABLISSEMENT (quel établissement gèrent-ils).
  etablissementId String?
  createdAt     DateTime @default(now())

  // Coordonnées du parent lui-même (pas celles d'un établissement) : pour
  // qu'un parent puisse être recontacté par l'association tierce, son email
  // et son téléphone doivent tous les deux être vérifiés — voir
  // lib/parentAuth.ts. Un signalement ne peut être déposé tant que ce n'est
  // pas le cas (RegleMetierError dans /api/signalement).
  telephone            String?
  emailVerifie         Boolean  @default(false)
  telephoneVerifie     Boolean  @default(false)
  // Codes de vérification à usage unique (démo : générés et affichés à
  // l'écran, jamais réellement envoyés — voir lib/parentAuth.ts).
  codeVerificationEmail     String?
  codeVerificationTelephone String?
}

// ---------------------------------------------------------------------------
// Géographie — permet la granularité dynamique du tableau de bord public.
// ---------------------------------------------------------------------------
model Commune {
  id             String          @id @default(cuid())
  nom            String
  epci           String
  departement    String
  // Académie de rattachement (voir lib/academies.ts). Table de correspondance
  // département -> académie volontairement statique et limitée : à remplacer
  // par un référentiel officiel avant tout usage en production. Valeur de
  // repli non bloquante, comme epci/departement ci-dessus.
  // TODO: intégration réelle (référentiel académique officiel)
  academie       String          @default("Académie inconnue")
  // Code INSEE (geo.api.gouv.fr) : sert de clé d'upsert quand une commune
  // est renseignée via la recherche publique plutôt que par le seed de démo
  // (auquel cas ce champ reste null — communes fictives, pas de code réel).
  codeInsee      String?         @unique
  etablissements Etablissement[]
}

model Etablissement {
  id        String   @id @default(cuid())
  nom       String
  adresse   String?
  communeId String
  commune   Commune  @relation(fields: [communeId], references: [id])
  // UAI (identifiant officiel, annuaire de l'éducation) : clé d'upsert pour
  // les établissements renseignés via la recherche publique. Null pour une
  // structure périscolaire absente de cet annuaire (saisie manuelle) ou pour
  // les établissements fictifs du seed de démo.
  uai       String?  @unique
  // Dernière synchronisation réussie avec l'annuaire de l'éducation
  // nationale (lib/annuaire.ts) ; null pour les établissements sans UAI ou
  // jamais synchronisés (seed de démo).
  derniereSyncAnnuaire DateTime?
  tickets   Ticket[]
  contacts  ContactCanal[]
  alertesQualiteDonnees AlerteQualiteDonnees[]
}

// ---------------------------------------------------------------------------
// Coordonnées de contact d'un établissement — annuaire qui s'enrichit dans
// le temps. La saisie du parent n'en est jamais la source principale : elle
// n'ajoute que des canaux secondaires (source = "propose_par_parent"),
// jamais automatiquement considérés "verifie". Seule une tentative de
// contact réelle ayant abouti (livrée ou ouverte) fait passer
// statutVerification à "verifie" — voir lib/contactVerification.ts.
// ---------------------------------------------------------------------------
model ContactCanal {
  id                 String    @id @default(cuid())
  etablissementId    String
  etablissement      Etablissement @relation(fields: [etablissementId], references: [id])
  type               String    // "email" | "telephone" | "courrier_recommande_electronique" | "adresse_postale"
  valeur             String
  // Pour un téléphone proposé par un parent : qui détient ce numéro
  // (ex. "Directeur", "Secrétariat"). Sans objet pour les autres types.
  porteur            String?
  source             String    // "annuaire_education_nationale" | "propose_par_parent" | "confirme_etablissement"
  statutVerification String    @default("non_verifie") // "non_verifie" | "verifie"
  derniereReussite   DateTime?
  derniereTentativeAt DateTime?
  echecsConsecutifs  Int       @default(0)
  createdAt          DateTime  @default(now())
  tentatives         TentativeContact[]
}

// ---------------------------------------------------------------------------
// Historique des tentatives de contact automatisées pour un ticket donné.
// ---------------------------------------------------------------------------
model TentativeContact {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id])
  contactCanalId String
  contactCanal   ContactCanal @relation(fields: [contactCanalId], references: [id])
  methode        String   // "email" | "sms" | "recommande_electronique"
  statut         String   // "envoye" | "livre" | "ouvert" | "echec_rebond" | "sans_reponse"
  timestamp      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Alerte interne (jamais publique) signalant des coordonnées d'établissement
// probablement obsolètes — destinée à la collectivité cliente, distincte des
// statistiques publiques de délai.
// ---------------------------------------------------------------------------
model AlerteQualiteDonnees {
  id              String   @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])
  message         String
  createdAt       DateTime @default(now())
  resolue         Boolean  @default(false)
}

// ---------------------------------------------------------------------------
// Contenu du signalement — jamais de nom en clair ici, uniquement des
// identifiants pseudonymes et des identifiants de structures.
// ---------------------------------------------------------------------------
model Ticket {
  id              String   @id @default(cuid())
  parentPseudoId  String
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])
  categorie       String
  contenu         String // en clair pour le MVP ; chiffrement par enregistrement en phase 2
  // "legere" | "moderee" | "grave" — jamais auto-déclarée par le parent,
  // dérivée automatiquement de `categorie` (config.ts -> CATEGORIE_GRAVITE).
  // Un ticket "grave" passe systématiquement par la triangulation de
  // l'association tierce, quelle que soit positionEtablissement ci-dessous
  // (lib/positionEtablissement.ts -> enregistrerPosition).
  gravite         String
  statut          String   @default("ouvert")
  // "ouvert" | "verification_contact_requise" | "triangulation_requise" |
  // "attente_cloture_parent" | "escaladé" | "escaladé_rectorat" |
  // "trianguléfondé" | "trianguléinfondé" | "clôturé_accord_mutuel"

  // Horodatage de la première tentative de contact automatisée ayant
  // effectivement abouti (livrée ou ouverte) — jamais le dépôt lui-même.
  // C'est ce champ, pas createdAt, qui alimente le délai officiel utilisé
  // par l'escalade automatique et les statistiques publiques.
  receptionConfirmeeAt DateTime?

  // Date et horaire des faits rapportés par le parent (distincts du dépôt
  // du signalement, createdAt). Optionnels, non structurants pour le délai
  // officiel — uniquement informatifs pour l'instruction du dossier.
  dateFaits    DateTime?
  horaireFaits String? // moment approximatif, ex. "14h30", "pendant la récréation du matin"

  // Prise de position structurée de l'établissement — remplace l'ancienne
  // étape unique de "réponse" libre. "conteste" | "non_conteste" | null tant
  // que non renseignée. Un seul enregistrement possible : aucun changement
  // rétroactif sans procédure de contestation dédiée, tracée séparément
  // (lib/positionEtablissement.ts -> enregistrerPosition).
  positionEtablissement     String?
  // Fige définitivement le délai "établissement" exposé dans les
  // statistiques publiques (lib/dashboardStats.ts, lib/exemplarite.ts, qui
  // continuent de lire `reponduAt`, toujours écrit au même instant par
  // enregistrerPosition) : ce qui se passe ensuite dans le dossier
  // (triangulation, escalade, clôture) ne le modifie jamais.
  positionEtablissementDate DateTime?

  // Commentaire libre optionnel accompagnant la prise de position
  // ci-dessus (ex. justification d'une contestation, mesure prise en cas
  // de non-contestation). reponduAt est toujours écrit au même instant que
  // positionEtablissementDate — conservé pour ne pas dupliquer le calcul du
  // délai "établissement" déjà en place dans lib/dashboardStats.ts et
  // lib/exemplarite.ts.
  reponseContenu  String?
  reponduAt       DateTime?
  escaladeAt      DateTime?

  verdict         String? // "fondé" | "à_investiguer" | "infondé"
  verdictAt       DateTime?

  clotureAt                DateTime?
  clotureRevocableJusqua    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs         AuditLog[]
  suitesJudiciaires SuiteJudiciaire[]
  tentativesContact TentativeContact[]
  personnesMiseEnCause PersonneMiseEnCause[]
  signalementsDormance SignalementDormance[]
}

// ---------------------------------------------------------------------------
// Identification de la ou des personnes mises en cause — strictement scopée
// au ticket (article 46 Loi Informatique et Libertés : un particulier ne
// peut traiter une donnée relative à une infraction que pour préparer ou
// suivre sa propre action de victime, jamais pour constituer un fichier
// consultable au-delà de son propre dossier).
//
// Plusieurs entrées sont possibles pour un même ticket (plusieurs personnes
// mises en cause dans un même signalement), mais chaque entrée reste liée à
// UN SEUL ticket via ticketId — jamais partagée ni réutilisée entre
// tickets. Volontairement AUCUN index sur nom/fonction : n'ajoute jamais un
// tel index, il rendrait possible/performante une requête du type "tous les
// tickets mentionnant telle personne", ce que ce modèle doit précisément
// empêcher. Le seul point d'accès autorisé à cette table est
// lib/personneMiseEnCause.ts -> recupererPersonnesMiseEnCause, qui ne fait
// de findMany que filtré sur un ticketId précis, jamais sur le contenu —
// voir les tests dédiés.
// ---------------------------------------------------------------------------
model PersonneMiseEnCause {
  id        String  @id @default(cuid())
  ticketId  String
  ticket    Ticket  @relation(fields: [ticketId], references: [id])
  nom       String?
  fonction  String? // ex. "enseignant", "animateur périscolaire", "autre élève"
  recurrent Boolean @default(false) // les faits se seraient déjà produits avec cette personne
}

// ---------------------------------------------------------------------------
// Journal d'audit à chaînage de hash — infalsifiable et traçable.
// ---------------------------------------------------------------------------
model AuditLog {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
  action        String
  // Identifiant pseudonyme du compte authentifié à l'origine de l'action (provenance).
  acteurPseudo  String
  hashPrecedent String
  hashCourant   String
  timestamp     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Suite judiciaire — purement auto-déclarative par le parent, jamais
// vérifiée, jamais exposée individuellement sur le dashboard public.
//
// Deux origines de saisine de la justice, indépendantes l'une de l'autre :
// une plainte déposée directement par le parent auprès de la police/
// gendarmerie ("plainte_directe_parent"), et l'escalade établissement ->
// rectorat déjà instrumentée par ce modèle ("transmission_etablissement").
// Les deux peuvent coexister pour un même ticket ("les_deux") : dans ce cas
// un seul enregistrement est mis à jour, jamais un second créé — voir
// lib/tickets.ts -> declarerPlainteDirecte.
// ---------------------------------------------------------------------------
model SuiteJudiciaire {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  // "plainte_directe_parent" | "transmission_etablissement" | "les_deux"
  origine     String   @default("transmission_etablissement")
  statut      String // "transmis" | "classé_sans_suite" | "renvoi_tribunal" | "condamnation" | "sans_nouvelle"
  // Référence du document justificatif téléversé (récépissé de dépôt de
  // plainte, courrier de classement sans suite, etc.). Nom de fichier
  // uniquement pour ce MVP — aucun stockage réel (mock, comme les autres
  // intégrations externes du projet).
  documentRef String?
  declaredAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Score de reconnaissance ("exemplarité") d'une entité (établissement,
// commune, EPCI, département, académie) — uniquement des métriques de
// process (délai, taux de réponse dans les délais, taux de dossiers résolus
// sans blocage), jamais le volume de signalements reçus : voir
// lib/exemplarite.ts, qui est le seul point de calcul et de lecture de ce
// modèle. nombreCasEligibles ne sert qu'à vérifier le seuil minimal avant
// tout classement — il n'entre jamais dans le calcul du score lui-même.
//
// Pas de badge permanent : chaque exécution du job périodique
// (lib/exemplarite.ts -> calculerScores) crée de nouvelles lignes
// horodatées (calculeLe) pour la période ; lib/exemplarite.ts ->
// getClassement exclut toute ligne de plus de BADGE_STALENESS_DAYS
// (config.ts) et revérifie en temps réel qu'aucun ticket actif de l'entité
// n'est actuellement en dépassement de délai (estExemplaireSuspendu),
// indépendamment du score historique.
// ---------------------------------------------------------------------------
model ExemplariteScore {
  id                 String   @id @default(cuid())
  entiteType         String   // "etablissement" | "commune" | "epci" | "departement" | "academie"
  // Identifiant de l'entité : l'id réel (Etablissement.id / Commune.id) pour
  // "etablissement"/"commune" ; le libellé de la maille (epci/departement/
  // academie sont de simples champs texte, pas des tables normalisées, à
  // l'image de lib/kAnonymity.ts) pour les trois autres types.
  entiteId           String
  periodeDebut       DateTime
  periodeFin         DateTime
  delaiMoyenReponse  Float // en heures
  tauxReponseDelai   Float // 0-1
  tauxSansBlocage    Float // 0-1
  nombreCasEligibles Int // seuil uniquement, jamais utilisé dans le score
  calculeLe          DateTime @default(now())

  @@index([entiteType, entiteId])
  @@index([entiteType, periodeDebut, periodeFin])
}

// ---------------------------------------------------------------------------
// Relance sur ticket dormant, déclenchée par l'établissement — étend le
// mécanisme de relance de l'association tierce déjà en place (section 4.4
// du PRD). Objectif : éviter l'accumulation de tickets ouverts dont le
// parent n'a plus donné signe de vie, sans jamais donner à l'établissement
// le pouvoir de les faire disparaître de ses propres statistiques. Le seul
// effet direct d'un signalement est de créer cette entrée et d'alimenter la
// file de relance de l'association tierce (lib/dormance.ts ->
// signalerDormance) : il ne modifie jamais, par lui-même, le statut du
// ticket. Seule lib/dormance.ts -> traiterRelance (rôle ASSOCIATION_TIERCE
// exclusivement) peut faire évoluer ce statut, une fois la relance traitée.
// ---------------------------------------------------------------------------
model SignalementDormance {
  id               String    @id @default(cuid())
  ticketId         String
  ticket           Ticket    @relation(fields: [ticketId], references: [id])
  signalePar       String // pseudoId du compte établissement à l'origine du signalement
  signaleLe        DateTime  @default(now())
  relanceEffectuee Boolean   @default(false)
  resultatRelance  String? // "reponse_obtenue" | "sans_nouvelle" | null tant que non traité
}
