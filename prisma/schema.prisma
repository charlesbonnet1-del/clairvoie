// Schéma Prisma — Clairvoie MVP
// Postgres (Supabase). DATABASE_URL = connexion via le pooler PgBouncer
// (utilisée à l'exécution) ; DIRECT_URL = connexion directe, requise par
// Prisma pour exécuter les migrations (le pooler ne les supporte pas).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identité — jamais mêlée au contenu des signalements (Ticket) au niveau du
// schéma. Le seul pont entre les deux mondes est le pseudoId, opaque.
// ---------------------------------------------------------------------------
model Identity {
  id            String   @id @default(cuid())
  pseudoId      String   @unique
  // "PARENT" | "ETABLISSEMENT" | "ASSOCIATION_TIERCE" | "RECTORAT" | "ADMIN"
  // Champ String plutôt qu'un enum Postgres natif : la liste exhaustive des
  // rôles autorisés vit dans config.ts (export ROLES), pas dans le schéma.
  // C'est cette liste, pas ce champ, que le test du principe 2 (aucun rôle
  // judiciaire) vérifie.
  role          String
  displayName   String // pour la démo uniquement, jamais exposé publiquement
  email         String   @unique
  passwordHash  String
  // Rattachement pour les comptes ETABLISSEMENT (quel établissement gèrent-ils).
  etablissementId String?
  createdAt     DateTime @default(now())

  // Coordonnées du parent lui-même (pas celles d'un établissement) : pour
  // qu'un parent puisse être recontacté par l'association tierce, son email
  // et son téléphone doivent tous les deux être vérifiés — voir
  // lib/parentAuth.ts. Un signalement ne peut être déposé tant que ce n'est
  // pas le cas (RegleMetierError dans /api/signalement).
  telephone            String?
  emailVerifie         Boolean  @default(false)
  telephoneVerifie     Boolean  @default(false)
  // Codes de vérification à usage unique (démo : générés et affichés à
  // l'écran, jamais réellement envoyés — voir lib/parentAuth.ts).
  codeVerificationEmail     String?
  codeVerificationTelephone String?
}

// ---------------------------------------------------------------------------
// Géographie — permet la granularité dynamique du tableau de bord public.
// ---------------------------------------------------------------------------
model Commune {
  id             String          @id @default(cuid())
  nom            String
  epci           String
  departement    String
  // Code INSEE (geo.api.gouv.fr) : sert de clé d'upsert quand une commune
  // est renseignée via la recherche publique plutôt que par le seed de démo
  // (auquel cas ce champ reste null — communes fictives, pas de code réel).
  codeInsee      String?         @unique
  etablissements Etablissement[]
}

model Etablissement {
  id        String   @id @default(cuid())
  nom       String
  adresse   String?
  communeId String
  commune   Commune  @relation(fields: [communeId], references: [id])
  // UAI (identifiant officiel, annuaire de l'éducation) : clé d'upsert pour
  // les établissements renseignés via la recherche publique. Null pour une
  // structure périscolaire absente de cet annuaire (saisie manuelle) ou pour
  // les établissements fictifs du seed de démo.
  uai       String?  @unique
  // Dernière synchronisation réussie avec l'annuaire de l'éducation
  // nationale (lib/annuaire.ts) ; null pour les établissements sans UAI ou
  // jamais synchronisés (seed de démo).
  derniereSyncAnnuaire DateTime?
  tickets   Ticket[]
  contacts  ContactCanal[]
  alertesQualiteDonnees AlerteQualiteDonnees[]
}

// ---------------------------------------------------------------------------
// Coordonnées de contact d'un établissement — annuaire qui s'enrichit dans
// le temps. La saisie du parent n'en est jamais la source principale : elle
// n'ajoute que des canaux secondaires (source = "propose_par_parent"),
// jamais automatiquement considérés "verifie". Seule une tentative de
// contact réelle ayant abouti (livrée ou ouverte) fait passer
// statutVerification à "verifie" — voir lib/contactVerification.ts.
// ---------------------------------------------------------------------------
model ContactCanal {
  id                 String    @id @default(cuid())
  etablissementId    String
  etablissement      Etablissement @relation(fields: [etablissementId], references: [id])
  type               String    // "email" | "telephone" | "courrier_recommande_electronique" | "adresse_postale"
  valeur             String
  // Pour un téléphone proposé par un parent : qui détient ce numéro
  // (ex. "Directeur", "Secrétariat"). Sans objet pour les autres types.
  porteur            String?
  source             String    // "annuaire_education_nationale" | "propose_par_parent" | "confirme_etablissement"
  statutVerification String    @default("non_verifie") // "non_verifie" | "verifie"
  derniereReussite   DateTime?
  derniereTentativeAt DateTime?
  echecsConsecutifs  Int       @default(0)
  createdAt          DateTime  @default(now())
  tentatives         TentativeContact[]
}

// ---------------------------------------------------------------------------
// Historique des tentatives de contact automatisées pour un ticket donné.
// ---------------------------------------------------------------------------
model TentativeContact {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id])
  contactCanalId String
  contactCanal   ContactCanal @relation(fields: [contactCanalId], references: [id])
  methode        String   // "email" | "sms" | "recommande_electronique"
  statut         String   // "envoye" | "livre" | "ouvert" | "echec_rebond" | "sans_reponse"
  timestamp      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Alerte interne (jamais publique) signalant des coordonnées d'établissement
// probablement obsolètes — destinée à la collectivité cliente, distincte des
// statistiques publiques de délai.
// ---------------------------------------------------------------------------
model AlerteQualiteDonnees {
  id              String   @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])
  message         String
  createdAt       DateTime @default(now())
  resolue         Boolean  @default(false)
}

// ---------------------------------------------------------------------------
// Contenu du signalement — jamais de nom en clair ici, uniquement des
// identifiants pseudonymes et des identifiants de structures.
// ---------------------------------------------------------------------------
model Ticket {
  id              String   @id @default(cuid())
  parentPseudoId  String
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])
  categorie       String
  contenu         String // en clair pour le MVP ; chiffrement par enregistrement en phase 2
  // "legere" | "moderee" | "grave" — jamais auto-déclarée par le parent,
  // dérivée automatiquement de `categorie` (config.ts -> CATEGORIE_GRAVITE).
  gravite         String
  statut          String   @default("ouvert")
  // "ouvert" | "verification_contact_requise" | "répondu" | "escaladé" |
  // "trianguléfondé" | "trianguléinfondé" | "clôturé_accord_mutuel"

  // Horodatage de la première tentative de contact automatisée ayant
  // effectivement abouti (livrée ou ouverte) — jamais le dépôt lui-même.
  // C'est ce champ, pas createdAt, qui alimente le délai officiel utilisé
  // par l'escalade automatique et les statistiques publiques.
  receptionConfirmeeAt DateTime?

  reponseContenu  String?
  reponduAt       DateTime?
  escaladeAt      DateTime?

  verdict         String? // "fondé" | "à_investiguer" | "infondé"
  verdictAt       DateTime?

  clotureAt                DateTime?
  clotureRevocableJusqua    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs         AuditLog[]
  suitesJudiciaires SuiteJudiciaire[]
  tentativesContact TentativeContact[]
  personneMiseEnCause PersonneMiseEnCause?
}

// ---------------------------------------------------------------------------
// Identification de la personne mise en cause — strictement scopée au
// ticket (article 46 Loi Informatique et Libertés : un particulier ne peut
// traiter une donnée relative à une infraction que pour préparer ou suivre
// sa propre action de victime, jamais pour constituer un fichier
// consultable au-delà de son propre dossier).
//
// ticketId est @unique : un seul enregistrement par ticket, jamais partagé.
// Volontairement AUCUN index sur nom/fonction/contexte : n'ajoute jamais un
// tel index, il rendrait possible/performante une requête du type "tous les
// tickets mentionnant telle personne", ce que ce modèle doit précisément
// empêcher. Le seul point d'accès autorisé à cette table est
// lib/personneMiseEnCause.ts -> recupererPersonneMiseEnCause, qui ne fait
// jamais de findMany/groupBy dessus — voir les tests dédiés.
// ---------------------------------------------------------------------------
model PersonneMiseEnCause {
  id           String    @id @default(cuid())
  ticketId     String    @unique
  ticket       Ticket    @relation(fields: [ticketId], references: [id])
  nom          String?
  fonction     String? // ex. "enseignant", "animateur périscolaire", "autre élève"
  dateFaits    DateTime? // date des faits, si connue
  horaireFaits String? // moment approximatif, ex. "14h30", "pendant la récréation du matin"
  recurrent    Boolean   @default(false) // les faits se seraient déjà produits
}

// ---------------------------------------------------------------------------
// Journal d'audit à chaînage de hash — infalsifiable et traçable.
// ---------------------------------------------------------------------------
model AuditLog {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
  action        String
  // Identifiant pseudonyme du compte authentifié à l'origine de l'action (provenance).
  acteurPseudo  String
  hashPrecedent String
  hashCourant   String
  timestamp     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Suite judiciaire — purement auto-déclarative par le parent, jamais
// vérifiée, jamais exposée individuellement sur le dashboard public.
// ---------------------------------------------------------------------------
model SuiteJudiciaire {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  statut      String // "transmis" | "classé_sans_suite" | "renvoi_tribunal" | "condamnation" | "sans_nouvelle"
  declaredAt  DateTime @default(now())
}
